<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<!-- ✔ Keep net8.0 (LTS, production-ready) -->

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

		<!-- 🔽 CHANGED: JwtBearer downgraded to .NET 8 compatible version -->
		<!-- Reason: 10.x packages are for .NET 10 preview and cause OpenAPI conflicts -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />

		<!-- ❌ REMOVED Microsoft.AspNetCore.OpenApi -->
		<!-- Reason: Conflicts with Swashbuckle + Clean Swagger setup -->

		<!-- 🔽 CHANGED: EF Core Design aligned with .NET 8 -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- ✔ Swagger (stable & recommended) -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

		<!-- 🔽 ADDED: Required for OpenApiReference, OpenApiSecurityScheme, etc. -->
		<PackageReference Include="Microsoft.OpenApi" Version="1.6.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ShoeEcommerce.Application\ShoeEcommerce.Application.csproj" />
		<ProjectReference Include="..\ShoeEcommerce.Infrastructure\ShoeEcommerce.Infrastructure.csproj" />
	</ItemGroup>

</Project>
