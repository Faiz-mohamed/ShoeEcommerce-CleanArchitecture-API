{
  "Razorpay": {
    "KeyId": "YOUR_RAZORPAY_KEY_ID",
    "KeySecret": "YOUR_RAZORPAY_KEY_SECRET"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER_NAME;Database=ShoeEcommerceDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARS",
    "Issuer": "ShoeEcommerceAPI",
    "Audience": "ShoeEcommerceClient",
    "ExpiryMinutes": 15
  },

  "AdminSettings": {
    "Email": "admin@example.com",
    "Password": "YOUR_STRONG_password123!",
    "FullName": "System Admin"
  },

  "RefreshTokenCleanup": {
    "CleanupIntervalHours": 24,
    "RetentionPeriodDays": 30,
    "EnableCleanup": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "AllowedHosts": "*"
}